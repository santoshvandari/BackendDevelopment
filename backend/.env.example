# PostgreSQL Connection String
DATABASE_URL=postgresql://user:password@localhost:5432/survey_db

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000

# JWT Settings
SECRET_KEY=your_secure_random_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Single Admin User Credentials
# Generate password hash with:
# python -c "from pwdlib import PasswordHash; print(PasswordHash.recommended().hash('your_password'))"
ADMIN_USERNAME=
ADMIN_HASHED_PASSWORD=
ADMIN_FULL_NAME=
ADMIN_EMAIL=
